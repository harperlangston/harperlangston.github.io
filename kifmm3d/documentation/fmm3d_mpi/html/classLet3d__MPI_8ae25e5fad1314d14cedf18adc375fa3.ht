<a class="anchor" name="8ae25e5fad1314d14cedf18adc375fa3"></a><!-- doxytag: member="Let3d_MPI::findGlbNode" ref="8ae25e5fad1314d14cedf18adc375fa3" args="(int depth, const Index3 &amp;path2Node)" --><p>
<table class="mdTable" cellpadding="2" cellspacing="0">
  <tr>
    <td class="mdRow">
      <table cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="md" nowrap valign="top">int Let3d_MPI::findGlbNode           </td>
          <td class="md" valign="top">(&nbsp;</td>
          <td class="md" nowrap valign="top">int&nbsp;</td>
          <td class="mdname" nowrap> <em>depth</em>, </td>
        </tr>
        <tr>
          <td class="md" nowrap align="right"></td>
          <td class="md"></td>
          <td class="md" nowrap>const Index3 &amp;&nbsp;</td>
          <td class="mdname" nowrap> <em>path2Node</em></td>
        </tr>
        <tr>
          <td class="md"></td>
