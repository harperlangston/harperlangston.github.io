<a name="l00059"></a>00059   <span class="keywordtype">double</span>* valArr; <a class="code" href="comobject__mpi_8hpp_b1b5a5fc3c0779898c5d4ef4d63f212e.html#b1b5a5fc3c0779898c5d4ef4d63f212e">pC</a>( VecGetArray( trgVal, &amp;valArr) );
<a name="l00060"></a>00060   <span class="keywordtype">double</span>* chkPosArr; <a class="code" href="comobject__mpi_8hpp_b1b5a5fc3c0779898c5d4ef4d63f212e.html#b1b5a5fc3c0779898c5d4ef4d63f212e">pC</a>( VecGetArray(chkPos, &amp;chkPosArr) );
