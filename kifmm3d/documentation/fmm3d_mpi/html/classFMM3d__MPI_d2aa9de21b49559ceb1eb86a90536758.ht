<a name="l00053"></a>00053   
<a name="l00054"></a>00054   Vec chkPos; <a class="code" href="comobject__mpi_8hpp_b1b5a5fc3c0779898c5d4ef4d63f212e.html#b1b5a5fc3c0779898c5d4ef4d63f212e">pC</a>( VecCreateMPI(<a class="code" href="classComObject__MPI_dcb2a13b1c9df08fe9bc759bcfdb150e.html#dcb2a13b1c9df08fe9bc759bcfdb150e">mpiComm</a>(), numChk*dim,  ttlChk*dim,  &amp;chkPos) ); <span class="comment">//check position</span>
