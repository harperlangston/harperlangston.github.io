<a name="l00062"></a>00062   <span class="keywordflow">for</span>(<span class="keywordtype">int</span> k=0; k&lt;numChk; k++) {
<a name="l00063"></a>00063          <span class="keywordflow">for</span>(<span class="keywordtype">int</span> i=0; i&lt;dim; i++)
<a name="l00064"></a>00064                 chkPosArr[ k*dim+i  ] = posArr[ chkVec[k]*dim+i  ];
<a name="l00065"></a>00065          <span class="keywordflow">for</span>(<span class="keywordtype">int</span> i=0; i&lt;trgDOF;i++)
<a name="l00066"></a>00066                 chkValArr[ k*trgDOF+i ] = valArr[ chkVec[k]*trgDOF+i ];
<a name="l00067"></a>00067   } 
