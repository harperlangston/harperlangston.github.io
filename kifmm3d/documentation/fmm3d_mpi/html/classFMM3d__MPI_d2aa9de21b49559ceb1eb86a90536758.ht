<a name="l00079"></a>00079          <a class="code" href="comobject__mpi_8hpp_b1b5a5fc3c0779898c5d4ef4d63f212e.html#b1b5a5fc3c0779898c5d4ef4d63f212e">pC</a>( VecScatterDestroy(ctx) );
<a name="l00080"></a>00080   }
