<a name="l00096"></a>00096   
<a name="l00097"></a>00097   DblNumMat inter(trgDOF, slclnum*srcDOF);
<a name="l00098"></a>00098   <span class="keywordflow">for</span>(<span class="keywordtype">int</span> i=0; i&lt;ttlChk; i++) {
