<a name="l00090"></a>00090   
<a name="l00091"></a>00091   DblNumMat lclSrcPosMat(dim, slclnum, <span class="keyword">false</span>, lclSrcPosArr);
<a name="l00092"></a>00092   DblNumMat lclSrcNorMat(dim, slclnum, <span class="keyword">false</span>, lclSrcNorArr);
