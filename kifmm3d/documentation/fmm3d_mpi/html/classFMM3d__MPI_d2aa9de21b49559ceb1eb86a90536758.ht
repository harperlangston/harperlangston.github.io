<a name="l00043"></a>00043   <span class="keywordtype">int</span> tlclnum = <a class="code" href="classKnlMat3d__MPI_21f80b863e1376ff6648d882fdabd08e.html#21f80b863e1376ff6648d882fdabd08e">procLclNum</a>(<a class="code" href="classKnlMat3d__MPI_a1b44c7c6fd0a38be167c34537b1a508.html#a1b44c7c6fd0a38be167c34537b1a508">_trgPos</a>);   <span class="comment">//int lclnum = this-&gt;lclnum();</span>
<a name="l00044"></a>00044   
<a name="l00045"></a>00045   <span class="comment">//1. select point to check</span>
<a name="l00046"></a>00046   <span class="keywordtype">int</span> ttlChk = numChk*<a class="code" href="classComObject__MPI_1cb28464592687ed96a57c17cd3e0773.html#1cb28464592687ed96a57c17cd3e0773">mpiSize</a>();
<a name="l00047"></a>00047   vector&lt;int&gt; chkVec(numChk);
<a name="l00048"></a>00048   <span class="keywordflow">for</span>(<span class="keywordtype">int</span> k=0; k&lt;numChk; k++) {
<a name="l00049"></a>00049          chkVec[k] = <span class="keywordtype">int</span>( floor(drand48()*tlclnum) );
<a name="l00050"></a>00050          <a class="code" href="comobject__mpi_8hpp_93b69b310934f98d76197daeb3bd62cc.html#93b69b310934f98d76197daeb3bd62cc">pA</a>(chkVec[k]&gt;=0 &amp;&amp; chkVec[k]&lt;tlclnum);
<a name="l00051"></a>00051   }
